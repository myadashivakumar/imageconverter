{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "imageconvertfastapi",
      "runtimeExecutable": "venv/bin/uvicorn",
      "runtimeArgs": ["app.main:app", "--reload", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "5500", "--directory", "frontend"],
      "port": 5500
    }
  ]
}
